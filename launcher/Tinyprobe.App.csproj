<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>tinyprobe-app</AssemblyName>
    <RootNamespace>Tinyprobe.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.1.1</VersionPrefix>

    <!-- One small native file: no runtime to install, and a start in milliseconds. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <!-- The Windows icon of the executable, shown by the shortcuts too. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationIcon>..\media\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page ships inside the executable: one file to download, and it always matches the launcher. -->
    <EmbeddedResource Include="..\web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\media\icon.png" LogicalName="media/icon.png" />
    <EmbeddedResource Include="..\media\icon.icns" LogicalName="media/icon.icns" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tinyprobe.App.Tests" />
  </ItemGroup>

</Project>
